# Optional: use a dedicated external PostgreSQL database instead of .local/pg-data.
# The normal local launch reads generated credentials from .local/database-url.
# DATABASE_URL=postgresql://terminal_lab:replace_me@127.0.0.1:55432/terminal_lab

# Optional assistant. Leave unset for the fully local evidence fallback.
# scripts/start.sh uses exported environment variables; it does not load .env.
# Configure the key locally, never in frontend code or versioned files.
# TERMINAL_ASSISTANT_PROVIDER=openai
# OPENAI_MODEL=gpt-5-mini
# OPENAI_API_KEY=your_local_secret

# Optional synthetic equipment sender, scoped to one imported run and source.
# Generate a random secret of at least 32 characters; do not commit its value.
# TERMINAL_FEED_TOKEN=
# TERMINAL_FEED_RUN=
# TERMINAL_FEED_SOURCE=fleet

# Private reviewer deployment behind an authenticated TLS reverse proxy.
# TERMINAL_ALLOWED_HOSTS=review.example.com,127.0.0.1
# TERMINAL_PROXY_KEY= # random shared secret injected by proxy, not by browser JS
# TERMINAL_SECURE_COOKIE=1
# TERMINAL_STATE_DIR=/private/path/to/runtime-state
